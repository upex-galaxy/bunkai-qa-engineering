{
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": ["-y", "@upstash/context7-mcp@4.0.3"]
    },
    "dbhub": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "DBHUB_TYPE,DBHUB_HOST,DBHUB_PORT,DBHUB_DATABASE,DBHUB_USER,DBHUB_PASSWORD",
        "--",
        "bunx",
        "-y",
        "@bytebase/dbhub@1.2.1",
        "--config",
        "dbhub.toml"
      ]
    },
    "openapi": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "API_BASE_URL,OPENAPI_SPEC_PATH",
        "--",
        "bunx",
        "-y",
        "@ivotoby/openapi-mcp-server@1.16.1",
        "--tools",
        "dynamic"
      ]
    }
  }
}
