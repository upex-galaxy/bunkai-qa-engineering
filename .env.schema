# ============================================================================
# .env.schema - project-owned env schema (varlock, env-spec)
# ============================================================================
# Delivered once by the boilerplate, then yours: bun run up never overwrites
# it. The framework half lives in .env.core.schema (generated + synced) and
# is pulled in by the import below. Add the variables YOUR project-under-test
# needs under "Project variables"; keep values out of this file.
#
# Validate:   bunx varlock load --agent      (redacted, agent-safe)
# Explain:    bunx varlock explain <VAR>
# Reference:  https://varlock.dev/reference/item-decorators
#
# @import(./.env.core.schema)
# @generateTsTypes(path=./env.d.ts, processEnv=none, importMetaEnv=none)
# @currentEnv=$TEST_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ----------------------------------------------------------------------------
# Project variables (add below; one decorator line per item, e.g.)
#   # Admin user for the back-office flows
#   # @required=forEnv(staging) @type=email
#   STAGING_ADMIN_EMAIL=
# ----------------------------------------------------------------------------

# Existing project on staging that the ATC integration specs attach new ATCs to (an id, not a secret). Reused on purpose: the ATC API has no DELETE and a workspace can hit its project limit. Read by config.atcTarget, which fails by name when empty. CI: GitHub Actions variable (vars.*), not a secret.
# Used by: config.atcTarget (config/variables.ts) -> tests/integration/atc/atc.test.ts
# Obtain: id of an existing project on staging (DBHub read-only SELECT).
STAGING_ATC_PROJECT_ID=

# Existing module of that project (id, not a secret). Same reuse rationale and failure mode as STAGING_ATC_PROJECT_ID.
# Used by: config.atcTarget (config/variables.ts) -> tests/integration/atc/atc.test.ts
# Obtain: id of an existing module on staging (DBHub read-only SELECT).
STAGING_ATC_MODULE_ID=

# Existing user story that belongs to that module (id, not a secret).
# Used by: config.atcTarget (config/variables.ts) -> tests/integration/atc/atc.test.ts
# Obtain: id of an existing user story on staging (DBHub read-only SELECT).
STAGING_ATC_USER_STORY_ID=

# Existing acceptance criterion that belongs to that user story (id, not a secret).
# Used by: config.atcTarget (config/variables.ts) -> tests/integration/atc/atc.test.ts
# Obtain: id of an existing acceptance criterion on staging (DBHub read-only SELECT).
STAGING_ATC_AC_ID=
